# Chrome / Puppeteer (optional — leave blank to use Puppeteer's bundled Chrome)
# Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=

# Ollama Configuration
OLLAMA_URL=http://localhost:11434

# Bot Configuration
NODE_ENV=production
LOG_LEVEL=info

# WhatsApp Configuration
WHATSAPP_SESSION_ID=my-bot-session

# Database Configuration
DB_PATH=./database/contacts.db

# Bot Personality
BOT_NAME=YourBotName
BOT_LANGUAGE=hebrew
OWNER_NAME=YourName
OWNER_PHONE=Your-Phone-Number
OWNER_EMAIL=your-email@example.com

# Timezone Configuration
TIMEZONE=Asia/Jerusalem
